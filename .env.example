# Optional: Slack integration for incident alerts
# Get your webhook URL from https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: Groq API key for AI-powered explanations (disabled by default)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=

# Set to 'true' to enable AI explanations (requires GROQ_API_KEY)
ENABLE_AI_EXPLAINER=false

# Optional: Groq model selection
GROQ_MODEL=llama-3.3-70b-versatile
