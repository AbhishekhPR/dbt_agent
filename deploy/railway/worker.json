{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python -m pip install --require-hashes -r requirements.lock && python -m pip install --no-deps -e ."
  },
  "deploy": {
    "startCommand": "python -m agent.worker.lifecycle_worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
