# Optional: Slack integration for incident alerts
# Get your webhook URL from https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional GitHub App Slack output (disabled when the Slack HTTPS webhook is empty)
# Retries: 0-5. Retry base: >0 and <=10 seconds; each delay is capped at 10s.
RELIUM_SLACK_WEBHOOK_URL=
RELIUM_SLACK_NOTIFY_WARN=false
RELIUM_SLACK_MAX_RETRIES=2
RELIUM_SLACK_RETRY_BASE_SECONDS=1

# Optional: Groq API key for AI-powered explanations (disabled by default)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=

# Set to 'true' to enable AI explanations (requires GROQ_API_KEY)
ENABLE_AI_EXPLAINER=false

# Optional: Groq model selection
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Polar billing (server-side only; none of these belongs in a VITE_ variable)
# ---------------------------------------------------------------------------
# All four are required together. With none set, /api/billing/* answers 503 and
# the deployment runs normally. With SOME set, the process refuses to start:
# a deployment that can start a checkout but cannot verify the webhook that
# grants the plan would charge customers and give them nothing.
#
# The product ids are what decide which plan a subscription grants. A price is
# never consulted, and any other product grants 'free'. Sandbox and production
# have separate tokens, secrets AND product ids. A Railway production deployment
# refuses to start unless POLAR_SERVER=production. The Organization Access Token
# needs products:read, checkouts:write and customer_sessions:write.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# 'production' (default) or 'sandbox'.
POLAR_SERVER=production

# 0-21. Keep equal to Polar's own "Grace period for benefit revocation"
# (Settings -> Subscriptions). 0 matches Polar's default of revoking at once.
POLAR_PAST_DUE_GRACE_DAYS=0
